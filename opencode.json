{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", ".agent/WORKFLOW.md", ".agent/CLOUDFLARE-WEB-TIENDA-LAUNCHER.md", ".agent/HTML-WEB-MODERNA.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "dotnet *": "allow",
      "npx wrangler *": "allow",
      "git *": "allow",
      "*": "ask"
    }
  }
}
