@model INNOVATE_INDUSTRIES_WEB_STORE.Models.VlogPageInfo
@{
    ViewData["Title"] = "Vlog";
}

<section class="hero-neon" style="padding-top:50px">
    <span class="badge-neon"><span class="pulse-dot"></span><span data-i18n="vg.badge">Vlog · Instagram · videos</span></span>
    <h1 class="section-title mt-3"><small data-i18n="vg.eyebrow">// Vlog en Instagram</small><span data-i18n="vg.ta">Vlog</span> <span class="text-magenta-neon" data-i18n="vg.tb">Innovate</span></h1>
    <p class="lead-muted" data-i18n="vg.lead">Los videos de INNOVATE INDUSTRIES en Instagram: reels, clips de eventos y detrás de cámaras, directo en esta página.</p>
    <div class="d-flex flex-wrap gap-3 mt-3">
        <a class="btn-neon btn-neon-magenta" href="@Model.ProfileUrl" target="_blank" rel="noopener" data-i18n="vg.btn_profile">Ver perfil en Instagram ↗</a>
        <a class="btn-neon-outline" asp-action="Index" data-i18n="vg.btn_home">← Inicio</a>
    </div>
</section>

<div class="neon-card p-4">
    <span class="card-tag tag-green" data-i18n="vg.status_tag">Cuenta verificada en vivo</span>
    <h4 class="text-white mt-2" style="font-family:var(--font-display)">@@@Model.Username</h4>
    @if (Model.Success && Model.IsReachable)
    {
        <p class="text-secondary mb-0"><span class="text-green-neon">●</span> <span data-i18n="vg.status_ok">@@innovateindustriesof responde en vivo</span></p>
    }
    else
    {
        <p class="text-secondary mb-0"><span>○</span> <span data-i18n="vg.status_unknown">No se pudo contactar a Instagram ahora mismo</span></p>
    }
</div>

<h2 class="section-title mt-5"><small data-i18n="vg.posts_eyebrow">// Últimos videos</small><span data-i18n="vg.posts_title">Directo de Instagram</span></h2>
<p class="text-secondary"><span data-i18n="vg.live_from">Contenido en vivo desde Instagram</span> · <a href="@Model.ProfileUrl" target="_blank" rel="noopener">@@innovateindustriesof</a></p>

<div class="neon-card p-2">
    <iframe src="@Model.EmbedUrl" title="Instagram: @@innovateindustriesof" loading="lazy"
            style="border:0;border-radius:8px;width:100%;height:640px;background:#000"></iframe>
</div>

@if (Model.PostEmbedUrls.Count > 0)
{
    <div class="row g-4 mt-1">
        @foreach (var url in Model.PostEmbedUrls.Take(6))
        {
            <div class="col-md-6 col-lg-4">
                <div class="neon-card p-3 h-100">
                    <blockquote class="instagram-media" data-instgrm-permalink="@url" data-instgrm-version="14"></blockquote>
                </div>
            </div>
        }
    </div>
    @section Scripts {
        <script async src="https://www.instagram.com/embed.js"></script>
    }
}
else
{
    <div class="neon-card p-4 mt-2" style="border-color:rgba(252,238,10,.5)">
        <span class="card-tag tag-green" data-i18n="vg.pending_tag">🔌 Conectar videos</span>
        <p class="text-secondary small mb-0" data-i18n="vg.pending">Pasa los links de tus reels o publicaciones y aparecerán aquí embebidos automáticamente, igual que el directo de Showcase.</p>
    </div>
}
