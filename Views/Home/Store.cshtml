@model List<INNOVATE_INDUSTRIES_WEB_STORE.Models.StoreGame>
@{
    ViewData["Title"] = "STORE";
}

<section class="hero-neon" style="padding-top:50px">
    <span class="badge-neon"><span class="pulse-dot"></span><span data-i18n="store.badge">Tienda · juegos</span></span>
    <h1 class="section-title mt-3"><small data-i18n="store.eyebrow">// Catálogo</small><span data-i18n="store.title">STORE</span></h1>
    <p class="lead-muted" data-i18n="store.lead">Juegos publicados por el equipo: carátula, precio y estado de lanzamiento.</p>
    <div class="d-flex flex-wrap gap-3 mt-3">
        <a class="btn-neon-outline" asp-action="Index" data-i18n="store.back">← Inicio</a>
    </div>
</section>

@if (Model.Count == 0)
{
    <p class="text-secondary" data-i18n="store.empty">Aún no hay juegos en la tienda. Vuelve pronto.</p>
}
else
{
    <div class="row g-4">
        @foreach (var g in Model)
        {
            <div class="col-md-6 col-lg-4 reveal">
                <div class="neon-card h-100 store-card">
                    <a asp-action="StoreDetalle" asp-route-id="@g.Id" class="store-cover-link">
                        <img class="card-img-top store-cover" src="@g.CoverPath" alt="Portada @g.Title" loading="lazy" />
                    </a>
                    <div class="card-body">
                        <h5 class="text-white mt-1">@g.Title</h5>
                        <div class="d-flex justify-content-between align-items-center gap-2 mt-2 flex-wrap">
                            @if (g.EnOferta)
                            {
                                <span><span class="price-old">$@g.Price.ToString("0.00")</span> <b class="store-price">$@g.PrecioEfectivo.ToString("0.00")</b></span>
                                <span class="card-tag tag-magenta" data-i18n="store.offer">OFERTA</span>
                            }
                            else
                            {
                                <b class="store-price">$@g.Price.ToString("0.00")</b>
                            }
                            @if (g.IsPreorder)
                            {
                                <span class="card-tag tag-magenta" data-i18n="store.preorder">EN DESARROLLO</span>
                            }
                            else if (g.IsEarlyAccess)
                            {
                                <span class="card-tag tag-cyan" data-i18n="store.early">ACCESO ANTICIPADO</span>
                            }
                        </div>
                        <a class="btn-neon-outline btn-sm px-3 py-2 mt-3 w-100 text-center" asp-action="StoreDetalle" asp-route-id="@g.Id"><span data-i18n="store.details">Ver ficha</span></a>
                        @if (g.IsPreorder)
                        {
                            <span class="btn-neon-outline btn-sm px-3 py-2 mt-2 w-100 text-center disabled" aria-disabled="true"><span data-i18n="store.preorder">EN DESARROLLO</span></span>
                        }
                        else
                        {
                            <a class="btn-neon btn-sm px-3 py-2 mt-2 w-100 text-center" asp-action="Pagar" asp-route-id="@g.Id"><span data-i18n="store.pay">Pagar</span></a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
