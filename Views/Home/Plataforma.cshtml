@model INNOVATE_INDUSTRIES_WEB_STORE.Models.LauncherBuild?
@using System.Linq
@using System.Text.Json
@{
    ViewData["Title"] = "Plataforma";
    List<string> galeria = new();
    try
    {
        galeria = JsonSerializer.Deserialize<List<string>>(Model?.ScreenshotsJson ?? "[]") ?? new();
    }
    catch { }
    if (galeria.Count == 0 && !string.IsNullOrEmpty(Model?.ScreenshotPath))
    {
        galeria.Add(Model!.ScreenshotPath);
    }
}

<section class="hero-neon" style="padding-top:50px">
    <h1 class="section-title mt-3"><span data-i18n="nav.plataforma">Plataforma</span></h1>
    @if (Model == null)
    {
        <p class="lead-muted" data-i18n="plat.soon">Contenido en preparación.</p>
    }
    else
    {
        <p class="lead-muted">
            <b class="text-white">@Model.Version</b>
            · @(Model.SizeBytes >= 1048576 ? $"{Model.SizeBytes / 1048576.0:0.#} MB" : $"{Model.SizeBytes / 1024.0:0.#} KB")
            · ↓ @Model.Downloads
            · @Model.CreatedAtUtc.ToString("dd/MM/yyyy") UTC
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-secondary" style="white-space:pre-wrap">@Model.Description</p>
        }
        @if (galeria.Count > 0)
        {
            <img src="@galeria[0]" alt="Captura @Model.Version" class="img-fluid rounded mt-2" loading="lazy" style="max-width:720px;width:100%" />
            @if (galeria.Count > 1)
            {
                <div class="d-flex flex-wrap gap-2 mt-2" style="max-width:720px">
                    @foreach (var shot in galeria.Skip(1).Take(3))
                    {
                        <img src="@shot" alt="Captura @Model.Version" class="img-fluid rounded" loading="lazy" style="width:32%;min-width:140px" />
                    }
                </div>
            }
        }
        var specs = (Model.Specs ?? string.Empty)
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim()).Where(s => s.Length > 0).Take(12).ToList();
        @if (specs.Count > 0)
        {
            <div class="neon-card p-4 mt-4" style="max-width:720px">
                <h6 class="text-white" data-i18n="plat.specs">Especificaciones</h6>
                <ul class="text-secondary small mb-0">
                    @foreach (var s in specs)
                    {
                        <li>@s</li>
                    }
                </ul>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <p class="text-secondary mt-3" style="white-space:pre-wrap">@Model.Notes</p>
        }
        <div class="d-flex flex-wrap gap-3 mt-3">
            <a class="btn-neon btn-neon-magenta" asp-action="DescargarLauncher" data-i18n="plat.dl_btn">⬇ Descargar launcher</a>
        </div>
    }
    <div class="mt-3">
        <a class="btn-neon-outline" asp-action="Index" data-i18n="plat.back">← Inicio</a>
    </div>
</section>
