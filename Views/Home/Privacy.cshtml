@{
    ViewData["Title"] = "Privacy Policy";
}
<section class="hero-neon" style="padding-top:50px">
    <span class="badge-neon" data-i18n="pr.badge">Legal · Gamer Privacy</span>
    <h1 class="section-title mt-3"><small data-i18n="pr.eyebrow">// Tus datos protegidos</small><span data-i18n="pr.title">Privacy Policy</span></h1>
    <div class="neon-card p-4 mt-3">
        <p class="text-secondary" data-i18n="pr.lead">Usa esta página para detallar la política de privacidad de tu tienda. Ejemplo gamer:</p>
        <ul class="text-secondary">
            <li data-i18n="pr.li1">No vendemos tu loot (datos) a terceros.</li>
            <li data-i18n="pr.li2">Las conexiones a Steam / Twitch / itch.io usan HTTPS y no guardan tu contraseña.</li>
            <li data-i18n="pr.li3">Puedes pedir borrado de cuenta en Discord 24/7.</li>
        </ul>
        <a class="btn-neon-outline" asp-action="Index" data-i18n="pr.back">Volver</a>
    </div>
</section>
