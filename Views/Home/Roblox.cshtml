@model INNOVATE_INDUSTRIES_WEB_STORE.Models.RobloxPageInfo
@{
    ViewData["Title"] = "Roblox";
}

<section class="hero-neon" style="padding-top:50px">
    <span class="badge-neon"><span class="pulse-dot"></span><span data-i18n="rx.badge">Hub · Roblox · Innovate</span></span>
    <h1 class="section-title mt-3"><small data-i18n="rx.eyebrow">// Universo Roblox</small><span data-i18n="rx.ta">Roblox</span> <span class="text-magenta-neon" data-i18n="rx.tb">Innovate</span></h1>
    <p class="lead-muted" data-i18n="rx.lead">El universo Roblox de INNOVATE INDUSTRIES: nuestro juego, el grupo oficial y cómo entrar. En cuanto se conecte el link oficial, esta página mostrará jugadores y visitas en vivo.</p>
    <div class="d-flex flex-wrap gap-3 mt-3">
        <a class="btn-neon" href="@Model.PageUrl" target="_blank" rel="noopener" data-i18n="rx.btn_play">Jugar en Roblox ↗</a>
        <a class="btn-neon-outline" asp-action="Index" data-i18n="rx.btn_home">← Inicio</a>
    </div>
</section>

@if (!Model.IsConnected)
{
    <div class="neon-card p-4 mt-2" style="border-color:rgba(252,238,10,.5)">
        <span class="card-tag tag-green" data-i18n="rx.pending_tag">🔌 Estado de conexión</span>
        <p class="text-secondary small mb-0" data-i18n="rx.pending">Aún no hay link oficial conectado. Pasa la URL del juego o del grupo de Roblox y esta categoría se sincronizará en vivo (jugadores, visitas, likes), igual que Plataforma y Eventos.</p>
    </div>
}

<div class="row g-4 mt-1">
    <div class="col-md-6">
        <div class="neon-card p-4 h-100">
            <span class="card-tag tag-magenta" data-i18n="rx.game_tag">Nuestro juego</span>
            <h4 class="text-white" style="font-family:var(--font-display)">@Model.GameName</h4>
            <p class="text-secondary" data-i18n="rx.game_d">La experiencia oficial de INNOVATE INDUSTRIES en Roblox. Entra, juega con la comunidad y sube de nivel.</p>
            <a class="btn-neon btn-neon-magenta" href="@Model.PageUrl" target="_blank" rel="noopener" data-i18n="rx.game_btn">Entrar al juego ↗</a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="neon-card p-4 h-100">
            <span class="card-tag tag-cyan" data-i18n="rx.group_tag">Grupo oficial</span>
            <h4 class="text-white" style="font-family:var(--font-display)">@Model.GroupName</h4>
            <p class="text-secondary" data-i18n="rx.group_d">Únete al grupo para noticias, rangos, eventos exclusivos y jugar con el equipo.</p>
            <a class="btn-neon-outline" href="@Model.PageUrl" target="_blank" rel="noopener" data-i18n="rx.group_btn">Unirse al grupo ↗</a>
        </div>
    </div>
</div>

<h2 class="section-title mt-5"><small data-i18n="rx.steps_eyebrow">// Cómo entrar</small><span data-i18n="rx.steps">Tres pasos</span></h2>
<div class="row g-3 mt-1">
    <div class="col-md-4"><div class="neon-card p-4 h-100"><span class="card-tag tag-cyan">01</span><h6 class="text-white" data-i18n="rx.s1t">Crea tu cuenta</h6><small class="text-secondary" data-i18n="rx.s1d">Regístrate gratis en Roblox desde PC, móvil o consola.</small></div></div>
    <div class="col-md-4"><div class="neon-card p-4 h-100"><span class="card-tag tag-magenta">02</span><h6 class="text-white" data-i18n="rx.s2t">Únete al grupo</h6><small class="text-secondary" data-i18n="rx.s2d">Entra al grupo oficial para rangos y avisos de eventos.</small></div></div>
    <div class="col-md-4"><div class="neon-card p-4 h-100"><span class="card-tag tag-green">03</span><h6 class="text-white" data-i18n="rx.s3t">Entra al juego</h6><small class="text-secondary" data-i18n="rx.s3d">Pulsa Jugar y aparece directo en la experiencia.</small></div></div>
</div>
