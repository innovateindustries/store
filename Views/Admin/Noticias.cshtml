@model List<INNOVATE_INDUSTRIES_WEB_STORE.Models.NewsItem>
@{
    ViewData["Title"] = "Noticias";
    Layout = "_AdminLayout";
    ViewData["AdminSection"] = "news";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2 class="section-title mt-2"><span data-i18n="adm.news_t">Noticias</span> (@Model.Count)</h2>
    <a class="btn-neon" asp-action="Crear" data-i18n="adm.btn_new">Nueva noticia</a>
</div>

<div class="row g-3 mt-1">
    @foreach (var n in Model)
    {
        <div class="col-md-6">
            <div class="neon-card p-3 h-100">
                @if (!string.IsNullOrEmpty(n.ImagePath))
                {
                    <img src="@n.ImagePath" alt="" class="img-fluid rounded mb-2" loading="lazy" style="max-height:160px;width:100%;object-fit:cover" />
                }
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <h6 class="text-white mb-0">@n.Title</h6>
                    @if (n.IsPublished)
                    {
                        <span class="text-green-neon small" data-i18n="adm.st_pub">● Publicada</span>
                    }
                    else
                    {
                        <span class="text-muted small" data-i18n="adm.st_draft">○ Borrador</span>
                    }
                </div>
                <small class="text-muted">@n.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC</small>
                <p class="text-secondary small mt-2" style="white-space:pre-wrap">@(n.Body.Length > 160 ? n.Body.Substring(0, 160) + "…" : n.Body)</p>
                @if (!string.IsNullOrEmpty(n.LinkUrl))
                {
                    <small><a href="@n.LinkUrl" target="_blank" rel="noopener">@(string.IsNullOrEmpty(n.LinkText) ? n.LinkUrl : n.LinkText) ↗</a></small>
                }
                <div class="d-flex gap-2 mt-2">
                    <form asp-action="ToggleNoticia" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@n.Id" />
                        <button type="submit" class="btn btn-sm btn-neon-outline" data-i18n="adm.btn_toggle">Publicar / Ocultar</button>
                    </form>
                    <form asp-action="DeleteNoticia" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@n.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" data-i18n="adm.btn_del">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
@if (Model.Count == 0)
{
    <p class="text-secondary mt-3" data-i18n="adm.empty_news">Aún no hay noticias. Publica la primera.</p>
}
