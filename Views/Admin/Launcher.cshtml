@model INNOVATE_INDUSTRIES_WEB_STORE.Models.SubirLauncherViewModel
@{
    ViewData["Title"] = "Launcher";
    Layout = "_AdminLayout";
    ViewData["AdminSection"] = "launcher";
    var builds = ViewData["Builds"] as List<INNOVATE_INDUSTRIES_WEB_STORE.Models.LauncherBuild> ?? new();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2 class="section-title mt-2"><span data-i18n="sb.launcher">Launcher</span> (@builds.Count)</h2>
</div>

<div class="neon-card p-4 mt-2">
    <form id="upForm" asp-action="SubirLauncher" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger small"></div>
        <p class="text-secondary small" data-i18n="adm.up_hint">Tip: si pesa más de 100 MB, súbelo desde http://localhost:5215 (la URL pública corta la subida).</p>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Version" class="form-label text-white" data-i18n="adm.up_version">Versión</label>
                <input asp-for="Version" class="form-control" placeholder="v1.0.0" />
            </div>
            <div class="col-md-5">
                <label asp-for="Archivo" class="form-label text-white" data-i18n="adm.up_file">Archivo (.zip, .exe, .msi · máx. 512 MB)</label>
                <input asp-for="Archivo" class="form-control" type="file" accept=".zip,.exe,.msi" />
            </div>
            <div class="col-md-4">
                <label asp-for="Screenshots" class="form-label text-white" data-i18n="adm.up_shots">Capturas (hasta 4 · JPG/PNG/GIF/WEBP · máx. 5 MB c/u)</label>
                <input asp-for="Screenshots" class="form-control" type="file" accept=".jpg,.jpeg,.png,.gif,.webp" multiple />
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label text-white" data-i18n="adm.up_desc">Descripción</label>
                <textarea asp-for="Description" class="form-control" rows="2" maxlength="4000"></textarea>
            </div>
            <div class="col-md-6">
                <label asp-for="Specs" class="form-label text-white" data-i18n="adm.up_specs">Ficha técnica (una por línea)</label>
                <textarea asp-for="Specs" class="form-control" rows="3" maxlength="2000" placeholder="Windows 10/11 64 bits&#10;Gratis&#10;Acceso anticipado"></textarea>
            </div>
            <div class="col-md-6">
                <label asp-for="Notes" class="form-label text-white" data-i18n="adm.up_notes">Notas de la versión (opcional)</label>
                <textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000"></textarea>
            </div>
        </div>
        <div class="form-check form-switch mt-3">
            <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
            <label asp-for="IsPublished" class="form-check-label text-white" data-i18n="adm.up_pub">Publicar al subir</label>
        </div>
        <div class="form-check form-switch mt-2">
            <input asp-for="IsMandatory" class="form-check-input" type="checkbox" />
            <label asp-for="IsMandatory" class="form-check-label text-white" data-i18n="adm.up_mandatory">Actualización obligatoria</label>
        </div>
        <button id="upBtn" type="submit" class="btn-neon mt-3" data-i18n="adm.btn_up">Subir launcher</button>
        <div id="upProg" class="progress mt-3" style="display:none;height:26px;background:rgba(0,0,0,.4)">
            <div id="upBar" class="progress-bar" role="progressbar" style="width:0%;background:linear-gradient(90deg,var(--magenta-500),var(--cyan-500))">0%</div>
        </div>
    </form>
</div>

<div class="row g-3 mt-1">
    @foreach (var b in builds)
    {
        <div class="col-md-6">
            <div class="neon-card p-3 h-100">
                @if (!string.IsNullOrEmpty(b.ScreenshotPath))
                {
                    <img src="@b.ScreenshotPath" alt="Captura @b.Version" class="img-fluid rounded mb-2" loading="lazy" style="max-height:160px;width:100%;object-fit:cover" />
                }
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <h6 class="text-white mb-0">@b.Version</h6>
                    @if (b.IsMandatory)
                    {
                        <span class="small" style="color:#ffd166" data-i18n="adm.st_mandatory">◆ Obligatoria</span>
                    }
                    else if (b.IsPublished)
                    {
                        <span class="text-green-neon small" data-i18n="adm.st_pub">● Publicada</span>
                    }
                    else
                    {
                        <span class="text-muted small" data-i18n="adm.st_draft">○ Borrador</span>
                    }
                </div>
                <small class="text-muted">
                    @b.FileName · @(b.SizeBytes >= 1048576 ? $"{b.SizeBytes / 1048576.0:0.#} MB" : $"{b.SizeBytes / 1024.0:0.#} KB")
                    · ↓ @b.Downloads · @b.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC
                </small>
                @if (!string.IsNullOrWhiteSpace(b.Description))
                {
                    <p class="text-secondary small mt-2 mb-0" style="white-space:pre-wrap">@(b.Description!.Length > 160 ? b.Description.Substring(0, 160) + "…" : b.Description)</p>
                }
                @if (!string.IsNullOrWhiteSpace(b.Notes))
                {
                    <p class="text-secondary small mt-2 mb-0" style="white-space:pre-wrap">@b.Notes</p>
                }
                <div class="d-flex gap-2 mt-2">
                    <form asp-action="ToggleLauncher" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@b.Id" />
                        <button type="submit" class="btn btn-sm btn-neon-outline" data-i18n="adm.btn_toggle">Publicar / Ocultar</button>
                    </form>
                    <form asp-action="DeleteLauncher" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@b.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" data-i18n="adm.btn_del">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
@if (builds.Count == 0)
{
    <p class="text-secondary mt-3" data-i18n="adm.empty_launch">Aún no hay builds. Sube el primero.</p>
}

@section Scripts {
<script>
document.getElementById('upForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var form = this;
    var btn = document.getElementById('upBtn');
    var wrap = document.getElementById('upProg');
    var bar = document.getElementById('upBar');
    btn.disabled = true;
    wrap.style.display = 'block';
    bar.style.width = '0%';
    bar.textContent = '0%';
    var xhr = new XMLHttpRequest();
    xhr.open('POST', form.action, true);
    xhr.upload.onprogress = function (ev) {
        if (ev.lengthComputable && ev.total > 0) {
            var p = Math.round(ev.loaded / ev.total * 100);
            bar.style.width = p + '%';
            bar.textContent = p + '%';
        } else {
            bar.textContent = (ev.loaded / 1048576).toFixed(1) + ' MB';
        }
    };
    xhr.onload = function () {
        if (xhr.status === 200) { document.open(); document.write(xhr.responseText); document.close(); }
        else { btn.disabled = false; bar.textContent = 'HTTP ' + xhr.status; }
    };
    xhr.onerror = function () { btn.disabled = false; bar.textContent = 'HTTP 0'; };
    try {
        xhr.send(new FormData(form));
    } catch (ex) {
        btn.disabled = false;
        bar.textContent = (ex && ex.name) ? ex.name : 'Error';
    }
});
</script>
}
