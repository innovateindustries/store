@model INNOVATE_INDUSTRIES_WEB_STORE.Models.AjustesViewModel
@{
    ViewData["Title"] = "Ajustes";
}

<section class="hero-neon" style="padding-top:50px">
    <span class="badge-neon"><span class="pulse-dot"></span><span data-i18n="set.badge">Tu vista</span></span>
    <h1 class="section-title mt-3"><small data-i18n="set.eyebrow">// Ajustes</small><span data-i18n="set.ta">Ajustes</span></h1>
    <p class="lead-muted" data-i18n="set.lead">Elige qué categorías quieres ver. Showcase está desactivada por defecto.</p>
</section>

@if (ViewData["Saved"] as bool? == true)
{
    <div class="alert mt-2" style="background:rgba(5,255,161,.08);border:1px solid var(--green-500);color:#d0ffe0" data-i18n="set.saved">✓ Ajustes guardados.</div>
}
@if (ViewData["Disabled"] as string is string disabled && disabled.Length > 0)
{
    <div class="alert mt-2" style="background:rgba(252,238,10,.07);border:1px solid rgba(252,238,10,.5);color:#fff9db" data-i18n="set.disabled">Esa categoría está desactivada. Actívala aquí para verla.</div>
}

<h2 class="section-title mt-4"><span data-i18n="set.always_t">Siempre visibles</span></h2>
<p class="text-secondary" data-i18n="set.always_d">Inicio, STORE, Plataforma y Noticias.</p>

<h2 class="section-title mt-4"><span data-i18n="set.opt_t">Opcionales (desactivadas por defecto)</span></h2>
<form asp-action="Ajustes" method="post" class="mt-2">
    <div class="row g-3">
        <div class="col-md-6">
            <div class="neon-card p-4 h-100">
                <div class="form-check form-switch">
                    <input asp-for="Showcase" class="form-check-input" type="checkbox" />
                    <label asp-for="Showcase" class="form-check-label text-white" style="font-family:var(--font-display)" data-i18n="nav.showcase">Showcase</label>
                </div>
                <small class="text-secondary" data-i18n="set.c_showcase_d">Directos de Twitch.</small>
            </div>
        </div>
    </div>
    <button type="submit" class="btn-neon mt-4" data-i18n="set.save">Guardar ajustes</button>
</form>
