
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tienda — INNOVATE (vista est&#225;tica)</title>
<link rel="stylesheet" href="./panel/style.css">
</head>
<body>
<header class="top"><b class="logo">INNOVATE</b><nav><a href="store.html">Tienda</a><a href="./Admin">Admin</a></nav><span class="sp"></span><span class="user" id="user"></span></header>
<main>
  <h2>Tienda</h2>
  <p class="meta" id="st">Cargando catálogo…</p>
  <div class="grid" id="grid"></div>
</main>
<script>
(function () {
  var grid = document.getElementById('grid'), st = document.getElementById('st');
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  fetch('/api/launcher/store/games').then(function (r) { return r.json(); }).then(function (j) {
    var gs = j.games || [];
    st.textContent = gs.length + (gs.length === 1 ? ' juego' : ' juegos');
    grid.innerHTML = gs.map(function (g) {
      var cover = g.coverPath ? '<img class="cover" src="' + esc(g.coverPath) + '" alt="">' : '';
      return '<div class="card">' + cover + '<div class="pad"><h3>' + esc(g.title) + '</h3>' +
        '<div class="meta">' + esc(g.genre || '') + '</div>' +
        '<div class="price">' + esc(g.priceText || '') + '</div>' +
        '<div><a class="btn primary" href="./Home/StoreDetalle/' + g.id + '">Ver / Comprar</a></div>' +
        '</div></div>';
    }).join('') || '<p>No hay juegos publicados.</p>';
  }).catch(function () { st.textContent = 'No se pudo cargar el catálogo. ¿Está corriendo el servidor?'; });
})();
</script>
</body>
</html>
